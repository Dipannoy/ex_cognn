#!/bin/sh
#SBATCH --job-name=jack_poly_eg_cubic_struct_sm_0210
#SBATCH -N 1
#SBATCH -n 14
#SBATCH --gres=gpu:1 ## Run on 1 GPU
#SBATCH --output jack_poly_eg_cubic_struct_sm_0210.out
#SBATCH --error jack_poly_eg_cubic_struct_sm_0210.err
#SBATCH -p v100-32gb-hiprio


##Load your modules and run code here

hostname
date

module load cuda/11.0
module load python3/anaconda/2021.11
source activate version
python -u main.py > jack_poly_eg_cubic_struct_sm_0210.out \
--root_dir 'datasets/jack_poly_eg' \
--config_name 'config_eg_coalignn.json' \
--dataset_name 'jack_poly_eg_cubic_struct.pickle' \
--target_file 'hf_seen_dp_hf_id.csv' \
--output_dir2 'hal_ef' \
--output_dir 'hal_ef_sm_0210' \
--ang_layer 1 \
--anlg_layer 0 \
--aln_layer 0 \
--gn_layer 2 \
--target 'Ef' \
--epochs 250 \
--batch_size 32 \

